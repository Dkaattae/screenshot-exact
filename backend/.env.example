# Copy to backend/.env. Every setting is optional in development.
TRYON_ENVIRONMENT=development
# Required outside development. Generate one with: openssl rand -hex 32
# TRYON_SECRET_KEY=
# Postgres from `docker compose up db`. Leave unset to use SQLite at ./data/app.db.
TRYON_DATABASE_URL=postgresql+psycopg://tryon:tryon@localhost:5433/tryon
TRYON_STORAGE_DIR=./data/files
TRYON_PUBLIC_BASE_URL=http://localhost:8000
TRYON_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# Built frontend to serve with create_site (frontend: SPA_BUILD=1 npm run build).
# TRYON_FRONTEND_DIR=../frontend/dist/client
